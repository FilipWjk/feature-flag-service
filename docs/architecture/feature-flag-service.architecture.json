  "cards": [
    {
      "dot": "cyan",
      "title": "HTTP behavior",
      "items": [
        "Blank userId: 400 ValidationProblemDetails",
        "Unknown feature: 404 ProblemDetails",
        "Known feature: 200 with enabled"
      ]
    },
    {
      "dot": "emerald",
      "title": "Rollout invariant",
      "items": [
        "Enabled=false disables the feature for every user",
        "100 percent enables the feature for every user",
        "Bucket < RolloutPercentage enables the feature"
      ]
    },
    {
      "dot": "violet",
      "title": "Why no user storage?",
      "items": [
        "The same input always produces the same bucket",
        "No state per user is required",
        "A rollout increase enables only additional buckets"
      ]
    }
  ]
